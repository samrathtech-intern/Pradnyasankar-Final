<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="R18bsEOcrKADpbV_q-2r">
    <mxGraphModel dx="2060" dy="1408" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Module A - Catalogue\n    Category {\n        string id PK\n        string name\n        string parent_category_id FK\n        string description\n        boolean is_active\n    }\n    Product {\n        string id PK\n        string category_id FK\n        string tax_class_id FK\n        string name\n        string slug\n        string description\n        decimal base_price\n        boolean is_active\n        timestamp created_at\n    }\n    ProductVariant {\n        string id PK\n        string product_id FK\n        string sku\n        decimal price\n        int stock_quantity\n        json attributes\n    }\n    ProductMedia {\n        string id PK\n        string product_id FK\n        string media_url\n        string media_type\n        int sort_order\n    }\n    TaxClass {\n        string id PK\n        string name\n        decimal rate\n    }\n    Attribute {\n        string id PK\n        string name\n        string type\n    }\n    AttributeValue {\n        string id PK\n        string attribute_id FK\n        string value\n    }\n    ProductAttributeValue {\n        string id PK\n        string product_id FK\n        string attribute_value_id FK\n    }\n    StockLedger {\n        string id PK\n        string product_id FK\n        string variant_id FK\n        int quantity_change\n        string reason\n        timestamp created_at\n    }\n\n    %% Module B - Customer\n    Customer {\n        string id PK\n        string email\n        string phone\n        string name\n        string password_hash\n        timestamp created_at\n    }\n    Address {\n        string id PK\n        string customer_id FK\n        string address_line1\n        string address_line2\n        string city\n        string state\n        string postal_code\n        string country\n        boolean is_default\n    }\n    Consent {\n        string id PK\n        string customer_id FK\n        string consent_type\n        timestamp granted_at\n    }\n\n    %% Module C - Cart &amp; Promotions\n    Cart {\n        string id PK\n        string customer_id FK\n        boolean is_active\n        timestamp created_at\n        timestamp updated_at\n    }\n    CartItem {\n        string id PK\n        string cart_id FK\n        string product_id FK\n        string variant_id FK\n        int quantity\n    }\n    Coupon {\n        string id PK\n        string code\n        string discount_type\n        decimal discount_value\n        decimal min_order_value\n        int max_uses\n        timestamp valid_from\n        timestamp valid_until\n    }\n    CouponScope {\n        string id PK\n        string coupon_id FK\n        string scope_type\n        string scope_id\n    }\n    CouponRedemption {\n        string id PK\n        string coupon_id FK\n        string customer_id FK\n        string order_id FK\n        timestamp redeemed_at\n    }\n\n    %% Module D - Orders\n    Order {\n        string id PK\n        string customer_id FK\n        string shipping_address_id FK\n        string billing_address_id FK\n        string status\n        decimal subtotal\n        decimal tax_amount\n        decimal shipping_amount\n        decimal discount_amount\n        decimal total\n        timestamp created_at\n    }\n    OrderItem {\n        string id PK\n        string order_id FK\n        string product_id FK\n        string variant_id FK\n        string product_name\n        string sku\n        decimal unit_price\n        int quantity\n        decimal total_price\n    }\n    OrderStatusHistory {\n        string id PK\n        string order_id FK\n        string status\n        string notes\n        timestamp created_at\n    }\n\n    %% Module E - Payments\n    RazorpayOrder {\n        string id PK\n        string order_id FK\n        string razorpay_order_id\n        decimal amount\n        string currency\n        string status\n        timestamp created_at\n    }\n    Payment {\n        string id PK\n        string order_id FK\n        string razorpay_payment_id\n        decimal amount\n        string status\n        string method\n        timestamp created_at\n    }\n    WebhookEvent {\n        string id PK\n        string order_id FK\n        string razorpay_event_id\n        string event_type\n        json payload\n        timestamp processed_at\n    }\n    Refund {\n        string id PK\n        string payment_id FK\n        string razorpay_refund_id\n        decimal amount\n        string reason\n        string status\n        timestamp created_at\n    }\n\n    %% Module F - Shipping &amp; Returns\n    Shipment {\n        string id PK\n        string order_id FK\n        string carrier\n        string tracking_number\n        string status\n        timestamp shipped_at\n        timestamp delivered_at\n    }\n    ShipmentTrackingEvent {\n        string id PK\n        string shipment_id FK\n        string status\n        string location\n        timestamp event_time\n    }\n    Cancellation {\n        string id PK\n        string order_id FK\n        string reason\n        string cancelled_by\n        timestamp cancelled_at\n    }\n    ReturnRequest {\n        string id PK\n        string order_id FK\n        string reason\n        string status\n        timestamp created_at\n    }\n    ReturnItem {\n        string id PK\n        string return_request_id FK\n        string order_item_id FK\n        int quantity\n        string condition\n    }\n\n    %% Module G - Invoicing\n    Invoice {\n        string id PK\n        string order_id FK\n        string invoice_number\n        timestamp issued_at\n        decimal total\n    }\n    CreditNote {\n        string id PK\n        string invoice_id FK\n        string credit_note_number\n        decimal amount\n        string reason\n        timestamp issued_at\n    }\n\n    %% Module H - Content/CMS\n    ContentPage {\n        string id PK\n        string slug\n        string title\n        text content\n        boolean is_published\n    }\n    Article {\n        string id PK\n        string title\n        string slug\n        text content\n        timestamp published_at\n    }\n    ArticleProduct {\n        string id PK\n        string article_id FK\n        string product_id FK\n    }\n    FAQ {\n        string id PK\n        string question\n        text answer\n        int sort_order\n    }\n    Media {\n        string id PK\n        string filename\n        string url\n        string mime_type\n        timestamp uploaded_at\n    }\n    Banner {\n        string id PK\n        string media_id FK\n        string title\n        string link_url\n        string position\n        boolean is_active\n    }\n\n    %% Module I - B2B Enquiries\n    B2BEnquiry {\n        string id PK\n        string company_name\n        string contact_name\n        string email\n        string phone\n        text message\n        string status\n        timestamp created_at\n    }\n    EnquiryAttachment {\n        string id PK\n        string enquiry_id FK\n        string file_url\n        string filename\n    }\n\n    %% Module J - Admin/Security\n    Role {\n        string id PK\n        string name\n        string description\n    }\n    Permission {\n        string id PK\n        string name\n        string resource\n        string action\n    }\n    RolePermission {\n        string id PK\n        string role_id FK\n        string permission_id FK\n    }\n    AdminUser {\n        string id PK\n        string role_id FK\n        string email\n        string name\n        string password_hash\n        boolean is_active\n    }\n    AuditLog {\n        string id PK\n        string admin_user_id FK\n        string action\n        string entity_type\n        string entity_id\n        json changes\n        timestamp created_at\n    }\n\n    %% Module K - Engagement Phase 2\n    Wishlist {\n        string id PK\n        string customer_id FK\n        string product_id FK\n        timestamp added_at\n    }\n    Review {\n        string id PK\n        string product_id FK\n        string customer_id FK\n        int rating\n        string title\n        text content\n        boolean is_approved\n        timestamp created_at\n    }\n\n    %% Module L - Shipping Config\n    ShippingZone {\n        string id PK\n        string name\n        json countries\n        json states\n    }\n    ShippingRate {\n        string id PK\n        string shipping_zone_id FK\n        string name\n        decimal min_weight\n        decimal max_weight\n        decimal rate\n    }\n\n    %% ========================================\n    %% RELATIONSHIPS\n    %% ========================================\n\n    %% Module A - Catalogue\n    Category ||--o{ Category : \&quot;parent_category_id\&quot;\n    Category ||--o{ Product : \&quot;category_id\&quot;\n    TaxClass ||--o{ Product : \&quot;tax_class_id\&quot;\n    Product ||--o{ ProductVariant : \&quot;product_id\&quot;\n    Product ||--o{ ProductMedia : \&quot;product_id\&quot;\n    Attribute ||--o{ AttributeValue : \&quot;attribute_id\&quot;\n    Product ||--o{ ProductAttributeValue : \&quot;product_id\&quot;\n    AttributeValue ||--o{ ProductAttributeValue : \&quot;attribute_value_id\&quot;\n    Product ||--o{ StockLedger : \&quot;product_id\&quot;\n    ProductVariant ||--o{ StockLedger : \&quot;variant_id\&quot;\n\n    %% Module B - Customer\n    Customer ||--o{ Address : \&quot;customer_id\&quot;\n    Customer ||--o{ Consent : \&quot;customer_id\&quot;\n\n    %% Module C - Cart &amp; Promotions\n    Customer ||--o{ Cart : \&quot;customer_id\&quot;\n    Cart ||--o{ CartItem : \&quot;cart_id\&quot;\n    Product ||--o{ CartItem : \&quot;product_id\&quot;\n    ProductVariant ||--o{ CartItem : \&quot;variant_id\&quot;\n    Coupon ||--o{ CouponScope : \&quot;coupon_id\&quot;\n    Coupon ||--o{ CouponRedemption : \&quot;coupon_id\&quot;\n    Customer ||--o{ CouponRedemption : \&quot;customer_id\&quot;\n\n    %% Module D - Orders\n    Customer ||--o{ Order : \&quot;customer_id\&quot;\n    Address ||--o{ Order : \&quot;shipping_address_id\&quot;\n    Address ||--o{ Order : \&quot;billing_address_id\&quot;\n    Order ||--o{ OrderItem : \&quot;order_id\&quot;\n    Product ||--o{ OrderItem : \&quot;product_id\&quot;\n    ProductVariant ||--o{ OrderItem : \&quot;variant_id\&quot;\n    Order ||--o{ OrderStatusHistory : \&quot;order_id\&quot;\n\n    %% Module E - Payments\n    Order ||--|| RazorpayOrder : \&quot;order_id\&quot;\n    Order ||--o{ Payment : \&quot;order_id\&quot;\n    Order ||--o{ WebhookEvent : \&quot;order_id\&quot;\n    Payment ||--o{ Refund : \&quot;payment_id\&quot;\n\n    %% Module F - Shipping &amp; Returns\n    Order ||--o{ Shipment : \&quot;order_id\&quot;\n    Shipment ||--o{ ShipmentTrackingEvent : \&quot;shipment_id\&quot;\n    Order ||--|| Cancellation : \&quot;order_id\&quot;\n    Order ||--o{ ReturnRequest : \&quot;order_id\&quot;\n    ReturnRequest ||--o{ ReturnItem : \&quot;return_request_id\&quot;\n    OrderItem ||--o{ ReturnItem : \&quot;order_item_id\&quot;\n\n    %% Module G - Invoicing\n    Order ||--|| Invoice : \&quot;order_id\&quot;\n    Invoice ||--o{ CreditNote : \&quot;invoice_id\&quot;\n\n    %% Module H - Content/CMS\n    Article ||--o{ ArticleProduct : \&quot;article_id\&quot;\n    Product ||--o{ ArticleProduct : \&quot;product_id\&quot;\n    Media ||--o{ Banner : \&quot;media_id\&quot;\n\n    %% Module I - B2B Enquiries\n    B2BEnquiry ||--o{ EnquiryAttachment : \&quot;enquiry_id\&quot;\n\n    %% Module J - Admin/Security\n    Role ||--o{ AdminUser : \&quot;role_id\&quot;\n    Role ||--o{ RolePermission : \&quot;role_id\&quot;\n    Permission ||--o{ RolePermission : \&quot;permission_id\&quot;\n    AdminUser ||--o{ AuditLog : \&quot;admin_user_id\&quot;\n\n    %% Module K - Engagement\n    Customer ||--o{ Wishlist : \&quot;customer_id\&quot;\n    Product ||--o{ Wishlist : \&quot;product_id\&quot;\n    Product ||--o{ Review : \&quot;product_id\&quot;\n    Customer ||--o{ Review : \&quot;customer_id\&quot;\n\n    %% Module L - Shipping Config\n    ShippingZone ||--o{ ShippingRate : \&quot;shipping_zone_id\&quot;\n\n    %% Cross-module\n    Order ||--o{ CouponRedemption : \&quot;order_id\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SCZtsPmw0UGmn5Gv8wNj-2521">
